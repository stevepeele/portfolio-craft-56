{
  "buildCommand": "bun run build",
  "framework": null,
  "installCommand": "bun install",
  "outputDirectory": ".vercel/output",
  "redirects": [
    {
      "destination": "/blog",
      "permanent": true,
      "source": "/writing"
    },
    {
      "destination": "/blog/:path*",
      "permanent": true,
      "source": "/writing/:path*"
    },
    {
      "source": "/hacking/promptvault",
      "destination": "/hacking/muse-vault",
      "permanent": true
    },
    {
      "source": "/hacking/promptvault/changelog",
      "destination": "/hacking/muse-vault/changelog",
      "permanent": true
    },
    {
      "source": "/building",
      "destination": "/hacking",
      "permanent": true
    },
    {
      "source": "/building/:path*",
      "destination": "/hacking/:path*",
      "permanent": true
    },
    {
      "source": "/hacking/wax-and-ash/changelog",
      "destination": "/hacking/wax-and-ash",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "destination": "https://:slug.vercel.app/:path*",
      "source": "/site-preview/:slug/:path*"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "lab.stevepeeleii.com"
        }
      ],
      "destination": "/lab/"
    }
  ]
}